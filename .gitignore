## .NET / C# .gitignore

# Build output directories - Main exclusions
**/bin/
**/obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet packages
*.nupkg
*.snupkg
**/packages/
!**/packages/build/

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Publish output
**/publish/
**/PublishProfiles/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Crash dumps
*.dmp
*.mdmp
